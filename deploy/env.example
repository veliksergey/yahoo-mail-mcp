# Copy to deploy/.env (gitignored) and fill in. Never commit the copy.

# The mailbox, and an app password generated at Yahoo > Account Security.
# Never the account password.
YAHOO_EMAIL=you@yahoo.com
YAHOO_APP_PASSWORD=

# Random token that forms the URL path: https://your-host/mcp/<MCP_SECRET>
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET=

# Optional display name on outgoing mail.
YAHOO_FROM_NAME=

# Who may call the server. Defaults to Anthropic's published egress range.
# ALLOW_CIDRS=160.79.104.0/21

# The header your reverse proxy fills in with the caller's address. Leave it
# empty only if clients connect to this process directly, with no proxy.
#   Fly.io              Fly-Client-IP
#   Cloudflare Tunnel   CF-Connecting-IP
#   Your own Caddy      X-Real-IP   (see deploy/Caddyfile.example)
TRUSTED_IP_HEADER=X-Real-IP

PORT=8080
