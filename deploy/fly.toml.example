# Fly.io configuration. Copy this file to the repository root as `fly.toml`
# (that path is gitignored) and set `app` to the name you claimed with
# `flyctl apps create`. The name becomes your public hostname, so make it
# unguessable and keep it out of version control.
app = "your-unique-name"

# Pick the region nearest you: `flyctl platform regions` lists them.
primary_region = "iad"

[build]

[env]
  PORT = "8080"
  # Anthropic's published egress range. Override with:
  #   flyctl secrets set ALLOW_CIDRS="160.79.104.0/21,THE.NEW.IP/32"
  ALLOW_CIDRS = "160.79.104.0/21"
  # Fly's proxy writes the caller's address into this header on every request,
  # so it is the one header the IP filter may believe.
  TRUSTED_IP_HEADER = "Fly-Client-IP"

[http_service]
  internal_port = 8080
  force_https = true
  auto_start_machines = true
  # Kept always-on: a cold start inside a connector call reads as a timeout.
  auto_stop_machines = "off"
  min_machines_running = 1
  processes = ["app"]

  [[http_service.checks]]
    grace_period = "10s"
    interval = "30s"
    method = "GET"
    path = "/health"
    timeout = "5s"

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
